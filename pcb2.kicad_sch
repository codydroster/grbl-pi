	(text "R1: inline 3V3 for J2 pin 7 (0R jumper, or a small resistor).\nR2-R4: RPR220 IR LED resistors from +5V (180R ~ 20 mA). Keep the phototransistor off 5V:\nsignal pins use the Teensy pull-up to 3.3V (Teensy 4.1 analog pins are not 5V tolerant).\nANALOG3 = Teensy 26 (A12), ANALOG4 = 27 (A13), ANALOG5 = 39 (A15)."
		(exclude_from_sim no)
		(at 248.92 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "20e1787d-fa5e-4aba-a00f-79c49402ad0f")
	)
